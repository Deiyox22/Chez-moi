<?xml version="1.0" encoding="UTF-8"?>
<!--
  Exemple minimal de flux produit Google Merchant (RSS 2.0).
  C'est le format que la plupart des enseignes fournissent a leurs partenaires.
  Pour tester l'import sans compte affilie :
    1. dans config/stores.json, mettez "enabled": true et
       "feed": { "type": "google-merchant-xml", "url": "./docs/exemple-flux-google-merchant.xml" }
    2. lancez : npm run catalog:sync -- ikea
-->
<rss version="2.0" xmlns:g="http://base.google.com/ns/1.0">
