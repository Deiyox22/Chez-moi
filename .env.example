# --- IA ---------------------------------------------------------------------
# Une seule cle suffit. L'application fonctionne avec Google Gemini ou avec
# Claude ; le fournisseur est deduit de la cle presente.

# Google Gemini (un palier gratuit existe) : https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Modele Gemini. Si celui-ci n'est pas accessible avec votre cle, le serveur
# renvoie la liste des modeles disponibles.
# GEMINI_MODEL=gemini-2.5-flash

# Modele d'image, pour le rendu photographique des amenagements.
# Alternative moins couteuse : gemini-3.1-flash-image
# GEMINI_IMAGE_MODEL=gemini-3-pro-image

# Anthropic Claude : https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5

# Forcer un fournisseur quand les deux cles sont presentes : gemini | anthropic
# AI_PROVIDER=gemini

# Effort de raisonnement (Claude uniquement) : low | medium | high | xhigh | max
# Par defaut high en local, medium sur Vercel (limite de duree des fonctions).
# ANTHROPIC_EFFORT=high

# Repli serveur si le modele refuse une requete (Claude uniquement)
# ANTHROPIC_ENABLE_FALLBACKS=1

# --- Catalogues -------------------------------------------------------------
# Recherche en direct sur les sites des magasins quand les catalogues locaux
# n'ont rien de pertinent. Chaque recherche consomme des jetons.
CATALOG_LIVE_SEARCH=0

# Nombre de resultats locaux en dessous duquel la recherche en ligne se declenche
# CATALOG_LIVE_MIN_RESULTS=2

# --- Serveur ----------------------------------------------------------------
PORT=8787

# Taille maximale d'une requete entrante (photos incluses), en octets
MAX_BODY_BYTES=26214400
