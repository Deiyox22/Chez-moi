# Cle API Anthropic (obligatoire pour les fonctions IA)
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Modele utilise pour l'analyse des photos et la generation des amenagements
ANTHROPIC_MODEL=claude-opus-5

# Effort de raisonnement : low | medium | high | xhigh | max
ANTHROPIC_EFFORT=high

# Active le repli serveur en cas de refus du modele (optionnel)
# ANTHROPIC_ENABLE_FALLBACKS=1

# Port du serveur
PORT=8787

# Taille maximale d'une requete entrante (photos incluses), en octets
MAX_BODY_BYTES=26214400
